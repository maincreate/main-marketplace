          },
          "restore": {
            "state": "planned",
            "capabilityId": "device.restore",
            "methods": [
              "verified-flash-image",
              "verified-partition-image"
            ],
            "requiresExactDeviceMatch": true,
            "requiresActiveChipProbe": true,
            "requiresExplicitApproval": true,
            "limitations": [
              "Reject mismatched chip family, flash size, image metadata or incompatible security state."
