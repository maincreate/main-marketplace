              "sdkconfig and sdkconfig.defaults",
              "build outputs and firmware artifacts",
              "logs",
              "device backups",
              "other installed ESP-IDF versions"
            ]
          }
        },
        "constraints": [
          "The current ESP-IDF build adapter does not yet enforce that installed idf.py matches the marketplace-selected version.",
          "Device flash and backup/restore adapters are not implemented in the current platform release."
        ]
